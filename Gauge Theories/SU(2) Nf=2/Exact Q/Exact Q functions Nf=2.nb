Cell[BoxData[
 RowBox[{"a", "\[Rule]", 
  RowBox[{
   SqrtBox["u"], "-", 
   FractionBox[
    RowBox[{"m1", " ", "m2", " ", 
     SubsuperscriptBox["\[CapitalLambda]", 
      TagBox["2",
       HoldForm], "2"]}], 
    RowBox[{"4", " ", 
