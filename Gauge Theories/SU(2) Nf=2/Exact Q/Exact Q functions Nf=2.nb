  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"solGHP", "[", 
        RowBox[{"P", ",", "q1", ",", "q2", ",", "opts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         FractionBox[
          RowBox[{"4", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[Pi]", "^", "3"}], "]"}]}], 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"1", "/", "4"}], "]"}], "^", "2"}]], 
         RowBox[{"Exp", "[", "\[Theta]", "]"}]}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Theta]", "+", 
          RowBox[{
           RowBox[{"Log", "[", "2", "]"}], "/", "2"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"q1", "+", "q2"}], ")"}]}], "+", "\[IndentingNewLine]", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "*", "2", "\[Pi]"}]], 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            FractionBox["1", 
             RowBox[{"Cosh", "[", 
              RowBox[{"\[Theta]", "-", "y"}], "]"}]], "\[IndentingNewLine]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"-", 
                    RowBox[{"y3", "[", "y", "]"}]}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"-", 
                    RowBox[{"y2", "[", "y", "]"}]}], "]"}]}], ")"}]}], "]"}], 
              "\[IndentingNewLine]", "-", 
              RowBox[{"I", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"y", "-", "\[Theta]"}], "]"}], 
               RowBox[{"Log", "[", 
                FractionBox[
                 RowBox[{"1", "+", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"-", 
