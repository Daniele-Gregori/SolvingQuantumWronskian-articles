Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"DSolveChangeVariables", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Inactive", "[", "DSolve", "]"}], "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[HBar]", "^", "2"}], " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"\[CapitalPsi]", "[", "z", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "2"}], "}"}]}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"\[CapitalLambda]", "^", "2"}]}], "/", "16"}], "-", 
                
                RowBox[{"m1", " ", 
                 RowBox[{"\[CapitalLambda]", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", "z"}], ")"}]}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"4", " ", "EE"}], "+", 
                   RowBox[{"\[HBar]", "^", "2"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"4", " ", 
                   RowBox[{"z", "^", "2"}]}], ")"}]}], "-", 
                RowBox[{"m2", " ", 
                 RowBox[{"\[CapitalLambda]", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", 
                    RowBox[{"z", "^", "3"}]}], ")"}]}]}], "-", 
                RowBox[{
                 RowBox[{"\[CapitalLambda]", "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"16", " ", 
                   RowBox[{"z", "^", "4"}]}], ")"}]}]}], ")"}], 
              RowBox[{"\[CapitalPsi]", "[", "z", "]"}]}]}], "==", "0"}], ",", 
           "\[CapitalPsi]", ",", "z"}], "]"}], ",", "\[CapitalPsi]", ",", "y",
          ",", 
         RowBox[{"y", "==", 
          RowBox[{"Log", "@", "z"}]}]}], "]"}], "//", "FullSimplify"}], "//", 
      "First"}], "//", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Times", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"1", "/", "16"}], 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], "y"}], "]"}]}]}], "]"}], "&"}], ",", "#"}], 
       "]"}], "&"}]}], "//", "Expand"}], "//", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"\[CapitalPsi]", "[", "y", "]"}], ",", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Prime]",
          MultilineFunction->None], "[", "y", "]"}], ",", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "y", "]"}]}], "}"}], ",", 
      "Simplify"}], "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eqAGH", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"DSolveChangeVariables", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Inactive", "[", "DSolve", "]"}], "[", 
               RowBox[{"%", ",", "\[CapitalPsi]", ",", "y"}], "]"}], ",", 
              "\[Psi]", ",", "y", ",", 
              RowBox[{
               RowBox[{"\[CapitalPsi]", "[", "y", "]"}], "==", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], 
                  RowBox[{"Integrate", "[", 
                   RowBox[{"1", ",", "y"}], "]"}]}], "]"}], 
                RowBox[{"\[Psi]", "[", "y", "]"}]}]}]}], "]"}], "//", 
            "FullSimplify"}], "//", "First"}], "//", "Expand"}], "//", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Times", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"1", "/", 
                 RowBox[{"(", 
                  RowBox[{"16", " ", 
                   RowBox[{"\[HBar]", "^", "2"}]}], ")"}]}], 
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  RowBox[{"-", "3"}], 
                  RowBox[{"y", "/", "2"}]}]]}]}], "]"}], "&"}], ",", "#"}], 
           "]"}], "&"}]}], "//", "FullSimplify"}], "//", 
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Psi]", "[", "y", "]"}], ",", 
            RowBox[{
             RowBox[{"\[Psi]", "''"}], "[", "y", "]"}]}], "}"}], ",", 
          "Expand"}], "]"}], "&"}]}], "//", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], "-", 
        RowBox[{"Last", "[", "#", "]"}]}], "&"}]}], "//", 
     RowBox[{
      RowBox[{"Times", "[", 
       RowBox[{"#", ",", 
