Cell[CellGroupData[{

Cell["TBA - exact", "Subsection",
 CellChangeTimes->{{3.971795405996921*^9, 3.9717954062770987`*^9}, {
  3.971796744806674*^9, 
  3.97179674645549*^9}},ExpressionUUID->"c18ef816-0c64-400f-8e9f-\
2aee02788621"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CLVSD", "[", "P_", "]"}], ":=", 
  RowBox[{"Log", "[", 
   FractionBox[
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "P"}], "]"}], 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"2", "P"}]}], "]"}]}], 
    RowBox[{"2", " ", "Pi"}]], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"bdyLVSD", "[", "P_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "8"}], "P", 
      RowBox[{"(", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "x"}], "]"}]}], "]"}], ")"}]}], "-", 
     RowBox[{
      RowBox[{"CLVSD", "[", "P", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Tanh", "[", 
         RowBox[{"x", "/", "2"}], "]"}]}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], "P", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], "x"}], "]"}]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"CLVSD", "[", "P", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Tanh", "[", "x", "]"}]}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tbaLVSD", "=", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Equal]", 
    RowBox[{
     FractionBox[
      RowBox[{"16", " ", 
       SuperscriptBox["\[ExponentialE]", "x"], " ", 
       SuperscriptBox["\[Pi]", 
        RowBox[{"3", "/", "2"}]]}], 
      SuperscriptBox[
       RowBox[{"Gamma", "[", 
        FractionBox["1", "4"], "]"}], "2"]], "-", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             RowBox[{"y", "[", "t", "]"}]}]]}], "]"}], " ", 
         RowBox[{"Sech", "[", 
          RowBox[{"t", "-", "x"}], "]"}]}], "\[Pi]"], 
       RowBox[{"\[DifferentialD]", "t"}]}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solLVSD", "[", "PP_", "]"}], ":=", 
  RowBox[{
   RowBox[{"solLVSD", "[", "PP", "]"}], "=", "\[IndentingNewLine]", 
   RowBox[{"ThermodynamicBetheAnsatzSolve", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tbaLVSD", "/.", 
      RowBox[{"P", "->", "PP"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<BoundaryCondition\>\"", "->", 
      RowBox[{"bdyLVSD", "[", "PP", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<GridResolution\>\"", "->", 
      RowBox[{"2", "^", "12"}]}], ",", 
     RowBox[{"\"\<StoppingAccuracy\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "15"}], ")"}]}]}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.9717954928922462`*^9, 3.971795502007902*^9}, {
  3.971795578261044*^9, 3.9717956054075613`*^9}, {3.97220348853586*^9, 
  3.972203509094742*^9}, {3.972203842035939*^9, 3.972203847514164*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"8aade0b1-05b3-47cf-81cd-d2bbc795d229"]
}, Closed]],

